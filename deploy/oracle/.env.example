# Create a Neon project manually and paste its pooled PostgreSQL connection URL.
# Keep this value private. Do not commit deploy/oracle/.env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# DNS A record for this hostname must point to the Oracle VM's public IP.
API_DOMAIN=api.example.com

# Add only the provider credentials Vox uses. Keep real values out of Git/chat.
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Optional model override; leave the VM's existing credential unchanged.
GEMINI_CHAT_MODEL=gemini-3.8-flash
# Optional real-time audio mode; paired devices only.
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_LIVE_ENABLED=true
TAVILY_API_KEY=
FAL_KEY=
KOKORO_URL=
KOKORO_API_KEY=
ELEVENLABS_API_KEY=

# Only set these if the service is reachable from the Oracle VM.
OLLAMA_URL=
OLLAMA_MODEL=llama3.1:8b

LOG_LEVEL=info
